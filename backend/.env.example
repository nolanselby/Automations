# Copy to .env and fill in from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# Local API port (Swift app expects 8787 by default)
FINANCE_API_PORT=8787

PLAID_REDIRECT_URI=https://localhost:8787/plaid/oauth
PLAID_COMPLETION_URI=https://localhost:8787/plaid/complete
